spec A1 {
    x = answer(),
    ensure x == 42
},

spec A2 {
    x = greet({ name: "Ada" }),
    ensure x == "Hello, Ada"
},

spec A5 {
    ensure identity(5) == 5
},

spec A9 {
    ensure empty() == []
},

spec A14 P {
    ensure load_settings("p").theme == "dark"
},

spec A14 Q {
    ensure load_settings("q") == {
        theme: "light", size: 12
    }
},

spec A15 {
    ensure divmod(7, 2).div == 3,
    ensure divmod(7, 2).mod == 1,
},

spec A6 {
    ensure f('true) == 1,
    ensure f('false) == 0,
},

spec A11 {
    x = 'a,
    y = case x { 'a -> 1, 'b -> 2 },
    ensure f(x) == 1,
},

spec A12 {
    ensure same(1, 1) == 'true,
    ensure same(1, 2) == 'false,
},

spec A13 {
    c = mk(),
    ensure c.compare(1, 1) == 'eq,
    ensure c.compare(1, 2) == 'lt,
},

spec A4 {
    x = some(?A),
    ensure identity(x) == x,
},

spec A5 {
    x = some(?A),
    ensure identity(x) == x,
    ensure identity(5) == 5,
},

spec A7 {
    x = some(?A),
    ensure pick(x, x) == x,
    y = some(?A),
    z = some(?B),
    ensure pick(y, z) == y,
},
