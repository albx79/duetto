{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "python@latest",
    "bubblewrap@latest",
    "claude-code@latest",
    "git@latest",
    "dash@latest",
    "curl@latest",
    "bash@latest",
    "coreutils@latest",
    "gnugrep@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ],
      "claude": [
          "bwrap",
          "--unshare-all",
          "--share-net",
          "--die-with-parent",
          "--new-session",
          "--bind", "$PWD", "$PWD",
          "--ro-bind", "/nix/store /nix/store",
          "--ro-bind", "$PWD/.devbox/nix/profile/default/", "/nix-profile",
          "--dir", "/home",
          "--dir", "/home/agent",
          "--bind", "$HOME/.local/share/agent-sandbox", "/home/agent",
          "--dir", "/etc",
          "--ro-bind", "/etc/resolv.conf /etc/resolv.conf",
          "--ro-bind", "/etc/hosts /etc/hosts",
          "--proc", "/proc",
          "--dev", "/dev",
          "--tmpfs", "/tmp",
          "--tmpfs", "/run",
          "--chdir", "$PWD",
          "--setenv", "HOME", "/tmp",
          "--setenv", "TMPDIR", "/tmp",
          "--setenv", "PATH", "/nix-profile/bin",
          "--", "claude", "--remote-control"
      ]
    }
  }
}
